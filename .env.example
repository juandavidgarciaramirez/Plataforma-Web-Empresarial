# URL base del backend NestJS (ver /backend). En desarrollo local corre en el puerto 3001.
# Producción: https://api.capitalconsulting.com.co/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# URL pública del sitio — fuente de `metadataBase`, canonical, robots.txt y
# sitemap.xml (ver src/config/site.ts). Producción: https://www.capitalconsulting.com.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analítica web propia (Etapa 15): activa en producción; en `next dev` solo con "true".
# "false" la desactiva en cualquier entorno.
# NEXT_PUBLIC_ANALYTICS_ENABLED=

# Solo si las imágenes del CMS se sirven desde un dominio distinto a la API (CDN).
# NEXT_PUBLIC_MEDIA_BASE_URL=
