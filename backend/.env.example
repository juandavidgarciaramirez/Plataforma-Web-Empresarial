# ==========================================================================
# Capital Consulting Backend — Environment Variables
# Copiar a `.env` y ajustar valores para desarrollo local.
# ==========================================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto donde escucha la API (el frontend espera http://localhost:3001/api/v1)
PORT=3001

# Prefijo global de la API
API_PREFIX=api/v1

# Orígenes permitidos por CORS (separados por coma). Usar "*" solo en desarrollo
# — nunca en producción, y menos con `credentials: true` (brief de seguridad,
# sección 31). Producción:
# CORS_ORIGINS=https://capitalconsulting.com.co,https://www.capitalconsulting.com.co
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------------------
# Base de datos (PostgreSQL real — Etapa 2)
# --------------------------------------------------------------------------
# Base de datos definitiva del proyecto: jud_platform_dev. NO crear otra.
# Si DB_PASSWORD trae caracteres reservados de URL (@, :, /, %, etc.),
# codificarlos en DATABASE_URL (ej. "*" -> %2A, ":" -> %3A).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-this-in-local-env
DB_DATABASE=jud_platform_dev
DATABASE_URL=postgresql://postgres:change-this-in-local-env@localhost:5432/jud_platform_dev?schema=public

# --------------------------------------------------------------------------
# JWT
# --------------------------------------------------------------------------
# IMPORTANTE: generar valores propios y secretos reales en producción.
# Nunca commitear el archivo .env con secretos reales.
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------------
# Rate limiting (Throttler)
# --------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Saltos de proxy de confianza para resolver la IP del cliente. Sin definir: solo
# conexiones locales (socket de Passenger o loopback), que es lo correcto detrás de
# Passenger. 0 = ignorar X-Forwarded-For. Ver docs/despliegue-etapa-15.md, fase 4.
# TRUST_PROXY_HOPS=

# --------------------------------------------------------------------------
# Administrador del sistema (rol "Administrador").
# SEED_ADMIN_EMAIL es OBLIGATORIA: los leads automáticos (Yuri, formulario de
# contacto) se asignan a este usuario. Sin ella no se pueden registrar leads.
# SEED_ADMIN_PASSWORD solo se usa para crear el usuario si todavía no existe:
# nunca cambia la contraseña de uno existente. No tiene valor por defecto.
# Verificar con: node scripts/verify-deploy.js crm
# --------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
# SEED_ADMIN_NAME=Administrador del sistema

# URL pública del frontend (usada en enlaces de correos, ej. reset de contraseña)
# Producción: https://www.capitalconsulting.com.co
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Archivos (adjuntos de PQR, hojas de vida de Careers) — Etapa 3
# --------------------------------------------------------------------------
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./uploads

# --------------------------------------------------------------------------
# Imágenes del CMS (Etapa 15) — ver docs/media-y-analitica.md
# --------------------------------------------------------------------------
# URL pública de las imágenes. OBLIGATORIA en producción (sin ella la carga
# responde 503). En desarrollo se deriva de PORT/API_PREFIX.
# Producción: https://api.capitalconsulting.com.co/api/v1/media/public
# MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_DIMENSION_PX=8000
MEDIA_MAX_GALLERY_IMAGES=12
MEDIA_ALLOWED_FORMATS=jpeg,png,webp,avif

# --------------------------------------------------------------------------
# Analítica web (Etapa 15)
# --------------------------------------------------------------------------
# Orígenes cuyo tráfico se registra (por defecto, CORS_ORIGINS). Producción:
# ANALYTICS_ALLOWED_ORIGINS=https://capitalconsulting.com.co,https://www.capitalconsulting.com.co
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_TIMEZONE=America/Bogota
ANALYTICS_RATE_LIMIT=120
# Cabecera con el país del visitante, si la infraestructura la envía (opcional).
# ANALYTICS_COUNTRY_HEADER=cf-ipcountry
