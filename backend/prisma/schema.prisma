generator client {
  provider = "prisma-client-js"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics", "audit", "careers", "catalog", "chat", "content", "core", "crm", "foundation", "pqr", "security"]
}

model address_types {
  id                BigInt              @id @default(autoincrement())
  code              String              @unique(map: "uk_catalog_address_type_code") @db.VarChar(50)
  name              String              @db.VarChar(100)
  description       String?
  is_active         Boolean             @default(true)
  sort_order        Int                 @default(0) @db.SmallInt
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  company_addresses company_addresses[]

  @@index([is_active], map: "idx_address_types_active")
  @@schema("catalog")
}

model company_types {
  id          BigInt      @id @default(autoincrement())
  uuid        String      @unique(map: "uk_catalog_company_type_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique(map: "uk_catalog_company_type_code") @db.VarChar(50)
  name        String      @db.VarChar(100)
  description String?
  is_active   Boolean     @default(true)
  sort_order  Int         @default(0) @db.SmallInt
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  companies   companies[]

  @@index([is_active], map: "idx_company_types_active")
  @@schema("catalog")
}

model contact_sources {
  id          BigInt     @id @default(autoincrement())
  uuid        String     @unique(map: "uk_catalog_contact_source_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique(map: "uk_catalog_contact_source_code") @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?
  is_active   Boolean    @default(true)
  sort_order  Int        @default(0) @db.SmallInt
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  contacts    contacts[]

  @@index([is_active], map: "idx_contact_sources_active")
  @@schema("catalog")
}

model email_types {
  id             BigInt           @id @default(autoincrement())
  code           String           @unique(map: "uk_catalog_email_type_code") @db.VarChar(50)
  name           String           @db.VarChar(100)
  description    String?
  is_active      Boolean          @default(true)
  sort_order     Int              @default(0) @db.SmallInt
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  contact_emails contact_emails[]

  @@index([is_active], map: "idx_email_types_active")
  @@schema("catalog")
}

model industries {
  id          BigInt      @id @default(autoincrement())
  uuid        String      @unique(map: "uk_catalog_industry_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique(map: "uk_catalog_industry_code") @db.VarChar(50)
  name        String      @db.VarChar(150)
  description String?
  is_active   Boolean     @default(true)
  sort_order  Int         @default(0) @db.SmallInt
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  companies   companies[]

  @@index([is_active], map: "idx_industries_active")
  @@schema("catalog")
}

model lead_priorities {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique(map: "uk_catalog_lead_priority_code") @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  level       Int      @default(0) @db.SmallInt
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0) @db.SmallInt
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active], map: "idx_lead_priorities_active")
  @@schema("catalog")
}

model lead_temperatures {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique(map: "uk_catalog_lead_temperature_code") @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  level       Int      @default(0) @db.SmallInt
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0) @db.SmallInt
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active], map: "idx_lead_temperatures_active")
  @@schema("catalog")
}

model phone_types {
  id             BigInt           @id @default(autoincrement())
  code           String           @unique(map: "uk_catalog_phone_type_code") @db.VarChar(50)
  name           String           @db.VarChar(100)
  description    String?
  is_active      Boolean          @default(true)
  sort_order     Int              @default(0) @db.SmallInt
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  contact_phones contact_phones[]

  @@index([is_active], map: "idx_phone_types_active")
  @@schema("catalog")
}

model rejection_reasons {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @unique(map: "uk_catalog_rejection_reason_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "uk_catalog_rejection_reason_code") @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0) @db.SmallInt
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active], map: "idx_rejection_reasons_active")
  @@schema("catalog")
}

model service_categories {
  id          BigInt     @id @default(autoincrement())
  uuid        String     @unique(map: "uk_catalog_service_category_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique(map: "uk_catalog_service_category_code") @db.VarChar(50)
  name        String     @db.VarChar(150)
  description String?
  icon        String?    @db.VarChar(100)
  is_active   Boolean    @default(true)
  sort_order  Int        @default(0) @db.SmallInt
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  services    services[]

  @@index([is_active], map: "idx_service_categories_active")
  @@schema("catalog")
}

model services {
  id                   BigInt                 @id @default(autoincrement())
  uuid                 String                 @unique(map: "uk_catalog_service_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id          BigInt?
  code                 String                 @unique(map: "uk_catalog_service_code") @db.VarChar(50)
  name                 String                 @db.VarChar(150)
  short_description    String?
  description          String?
  icon                 String?                @db.VarChar(100)
  is_featured          Boolean                @default(false)
  is_active            Boolean                @default(true)
  sort_order           Int                    @default(0) @db.SmallInt
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  image_url            String?
  image_alt            String?                @db.VarChar(300)
  service_categories   service_categories?    @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_catalog_service_category")
  chat_context         chat_context[]
  chat_messages        chat_messages[]
  chat_service_matches chat_service_matches[]
  hero_slides          hero_slides[]
  team_members         team_members[]

  @@index([is_active], map: "idx_services_active")
  @@index([category_id], map: "idx_services_category")
  @@schema("catalog")
}

model social_networks {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "uk_catalog_social_network_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique(map: "uk_catalog_social_network_code") @db.VarChar(50)
  name       String   @db.VarChar(100)
  icon       String?  @db.VarChar(100)
  base_url   String?
  is_active  Boolean  @default(true)
  sort_order Int      @default(0) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active], map: "idx_social_networks_active")
  @@schema("catalog")
}

model core_audit_logs {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt?
  module      String?   @db.VarChar(80)
  entity_name String?   @db.VarChar(80)
  entity_id   BigInt?
  action      String?   @db.VarChar(50)
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.VarChar(45)
  user_agent  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_user")

  @@map("audit_logs")
  @@schema("core")
}

model branches {
  id                BigInt              @id @default(autoincrement())
  uuid              String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        BigInt
  city_id           BigInt?
  name              String              @db.VarChar(150)
  code              String?             @db.VarChar(20)
  manager_name      String?             @db.VarChar(150)
  opening_hours     String?             @db.VarChar(150)
  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  is_main           Boolean?            @default(false)
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  cities            cities?             @relation(fields: [city_id], references: [id], onUpdate: NoAction, map: "fk_branch_city")
  companies         companies           @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_branch_company")
  company_addresses company_addresses[]
  contacts          contacts[]

  @@index([is_active], map: "idx_branch_active")
  @@index([city_id], map: "idx_branch_city")
  @@index([company_id], map: "idx_branch_company")
  @@schema("core")
}

model cities {
  id                BigInt              @id @default(autoincrement())
  uuid              String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state_id          BigInt
  name              String              @db.VarChar(120)
  postal_code       String?             @db.VarChar(20)
  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  divipola_code     String              @unique(map: "uk_cities_divipola_code") @db.VarChar(5)
  candidates        candidates[]
  branches          branches[]
  states            states              @relation(fields: [state_id], references: [id], onUpdate: NoAction, map: "fk_cities_state")
  company_addresses company_addresses[]
  contact_addresses contact_addresses[]

  @@unique([state_id, name], map: "uk_city_state_name")
  @@index([name], map: "idx_cities_name")
  @@index([state_id], map: "idx_cities_state")
  @@index([divipola_code], map: "idx_city_divipola")
  @@schema("core")
}

model companies {
  id                                          BigInt                    @id @default(autoincrement())
  uuid                                        String                    @unique(map: "uk_company_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_id                                  BigInt
  legal_name                                  String                    @db.VarChar(200)
  commercial_name                             String?                   @db.VarChar(200)
  tax_id                                      String?                   @unique(map: "uk_company_tax") @db.VarChar(30)
  verification_digit                          String?                   @db.VarChar(5)
  company_type                                String?                   @db.VarChar(100)
  industry                                    String?                   @db.VarChar(150)
  website                                     String?                   @db.VarChar(255)
  email                                       String?                   @db.VarChar(255)
  phone                                       String?                   @db.VarChar(50)
  logo_url                                    String?
  cover_image_url                             String?
  description                                 String?
  slogan                                      String?                   @db.VarChar(255)
  founded_at                                  DateTime?                 @db.Date
  employees_count                             Int?                      @default(0)
  primary_color                               String?                   @db.VarChar(20)
  secondary_color                             String?                   @db.VarChar(20)
  linkedin_url                                String?
  facebook_url                                String?
  instagram_url                               String?
  youtube_url                                 String?
  tiktok_url                                  String?
  is_active                                   Boolean                   @default(true)
  created_at                                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime                  @default(now()) @db.Timestamptz(6)
  company_type_id                             BigInt?
  industry_id                                 BigInt?
  branches                                    branches[]
  countries                                   countries                 @relation(fields: [country_id], references: [id], onUpdate: NoAction, map: "fk_company_country")
  industries                                  industries?               @relation(fields: [industry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_industry")
  company_types                               company_types?            @relation(fields: [company_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_type")
  company_addresses                           company_addresses[]
  company_emails                              company_emails[]
  company_phones                              company_phones[]
  company_settings                            company_settings?
  company_social_networks                     company_social_networks[]
  contacts                                    contacts[]
  lead_activities                             lead_activities[]
  lead_notes                                  lead_notes[]
  lead_tags                                   lead_tags[]
  leads_leads_converted_company_idTocompanies leads[]                   @relation("leads_converted_company_idTocompanies")
  leads_leads_company_idTocompanies           leads[]                   @relation("leads_company_idTocompanies")
  opportunities                               opportunities[]
  files                                       files[]
  requests                                    requests[]

  @@index([is_active], map: "idx_company_active")
  @@index([company_type_id], map: "idx_company_company_type")
  @@index([country_id], map: "idx_company_country")
  @@index([industry_id], map: "idx_company_industry")
  @@index([legal_name], map: "idx_company_name")
  @@schema("core")
}

model company_addresses {
  id              BigInt         @id @default(autoincrement())
  uuid            String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      BigInt
  branch_id       BigInt?
  city_id         BigInt?
  address         String         @db.VarChar(300)
  neighborhood    String?        @db.VarChar(150)
  postal_code     String?        @db.VarChar(20)
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)
  address_type    String?        @db.VarChar(50)
  is_primary      Boolean?       @default(false)
  is_active       Boolean?       @default(true)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @default(now()) @db.Timestamptz(6)
  address_type_id BigInt?
  branches        branches?      @relation(fields: [branch_id], references: [id], onUpdate: NoAction, map: "fk_company_address_branch")
  cities          cities?        @relation(fields: [city_id], references: [id], onUpdate: NoAction, map: "fk_company_address_city")
  companies       companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_address_company")
  address_types   address_types? @relation(fields: [address_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_company_address_type")

  @@index([city_id], map: "idx_company_address_city")
  @@index([company_id], map: "idx_company_address_company")
  @@index([address_type_id], map: "idx_company_address_type")
  @@schema("core")
}

model company_emails {
  id          BigInt    @id @default(autoincrement())
  company_id  BigInt
  email       String    @db.VarChar(255)
  description String?   @db.VarChar(100)
  is_primary  Boolean?  @default(false)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_email")

  @@index([company_id], map: "idx_company_email_company")
  @@schema("core")
}

model company_phones {
  id          BigInt    @id @default(autoincrement())
  company_id  BigInt
  phone       String    @db.VarChar(40)
  extension   String?   @db.VarChar(20)
  whatsapp    Boolean?  @default(false)
  description String?   @db.VarChar(100)
  is_primary  Boolean?  @default(false)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_phone")

  @@index([company_id], map: "idx_company_phone_company")
  @@schema("core")
}

model company_settings {
  id                  BigInt    @id @default(autoincrement())
  company_id          BigInt    @unique
  company_logo        String?
  favicon             String?
  primary_color       String?   @db.VarChar(20)
  secondary_color     String?   @db.VarChar(20)
  accent_color        String?   @db.VarChar(20)
  website             String?   @db.VarChar(255)
  timezone            String?   @db.VarChar(80)
  language            String?   @db.VarChar(20)
  currency            String?   @db.VarChar(20)
  date_format         String?   @db.VarChar(30)
  time_format         String?   @db.VarChar(20)
  smtp_host           String?   @db.VarChar(255)
  smtp_port           Int?
  smtp_user           String?   @db.VarChar(255)
  smtp_password       String?
  smtp_ssl            Boolean?  @default(true)
  google_analytics_id String?   @db.VarChar(100)
  google_tag_manager  String?   @db.VarChar(100)
  meta_pixel          String?   @db.VarChar(100)
  whatsapp_number     String?   @db.VarChar(50)
  google_maps_url     String?
  maintenance_mode    Boolean?  @default(false)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  companies           companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_settings")

  @@schema("core")
}

model company_social_networks {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        BigInt
  platform          String    @db.VarChar(50)
  username          String?   @db.VarChar(150)
  url               String
  is_primary        Boolean?  @default(false)
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  social_network_id BigInt?
  companies         companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_social")

  @@index([company_id], map: "idx_company_social_company")
  @@index([social_network_id], map: "idx_company_social_network")
  @@schema("core")
}

model contact_addresses {
  id          BigInt    @id @default(autoincrement())
  contact_id  BigInt
  city_id     BigInt?
  address     String
  postal_code String?   @db.VarChar(20)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  type        String?   @db.VarChar(50)
  is_primary  Boolean?  @default(false)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  contacts    contacts  @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_address")
  cities      cities?   @relation(fields: [city_id], references: [id], onUpdate: NoAction, map: "fk_contact_address_city")

  @@index([contact_id], map: "idx_contact_address_contact")
  @@schema("core")
}

model contact_emails {
  id            BigInt       @id @default(autoincrement())
  uuid          String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id    BigInt
  email         String       @unique(map: "idx_contact_email_unique") @db.VarChar(255)
  email_type    String?      @db.VarChar(50)
  is_primary    Boolean?     @default(false)
  is_verified   Boolean?     @default(false)
  is_active     Boolean?     @default(true)
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  email_type_id BigInt?
  contacts      contacts     @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_email")
  email_types   email_types? @relation(fields: [email_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contact_email_type")

  @@index([contact_id], map: "idx_contact_email_contact")
  @@index([email_type_id], map: "idx_contact_email_type")
  @@schema("core")
}

model contact_phones {
  id            BigInt       @id @default(autoincrement())
  contact_id    BigInt
  phone         String       @db.VarChar(40)
  extension     String?      @db.VarChar(20)
  type          String?      @db.VarChar(50)
  whatsapp      Boolean?     @default(false)
  is_primary    Boolean?     @default(false)
  is_active     Boolean?     @default(true)
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  phone_type_id BigInt?
  contacts      contacts     @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_phone")
  phone_types   phone_types? @relation(fields: [phone_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contact_phone_type")

  @@index([contact_id], map: "idx_contact_phone_contact")
  @@index([phone_type_id], map: "idx_contact_phone_type")
  @@schema("core")
}

model contact_social_networks {
  id                BigInt    @id @default(autoincrement())
  contact_id        BigInt
  platform          String    @db.VarChar(50)
  username          String?   @db.VarChar(150)
  url               String?
  is_primary        Boolean?  @default(false)
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  social_network_id BigInt?
  contacts          contacts  @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_social")

  @@index([contact_id], map: "idx_contact_social_contact")
  @@index([social_network_id], map: "idx_contact_social_network")
  @@schema("core")
}

model contacts {
  id                                         BigInt                    @id @default(autoincrement())
  uuid                                       String                    @unique(map: "uk_contact_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                                 BigInt
  branch_id                                  BigInt?
  first_name                                 String                    @db.VarChar(100)
  middle_name                                String?                   @db.VarChar(100)
  last_name                                  String                    @db.VarChar(100)
  second_last_name                           String?                   @db.VarChar(100)
  full_name                                  String?                   @db.VarChar(300)
  identification_type                        String?                   @db.VarChar(20)
  identification_number                      String?                   @db.VarChar(50)
