{
  "name": "backend",
  "version": "1.0.0",
  "description": "Capital Consulting and Services SAS — API backend (NestJS). Repository Pattern desacoplado, implementación temporal en memoria a la espera del esquema PostgreSQL definitivo.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build && npm run copy:migrations",
    "copy:migrations": "node -e \"const fs=require('fs');const path=require('path');const src=path.resolve(__dirname,'../database/migrations');const dst=path.resolve(__dirname,'dist/database/migrations');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){if(/^\\d{3}_.*\\.sql$/i.test(f)&&!/_verify\\.sql$/i.test(f))fs.copyFileSync(path.join(src,f),path.join(dst,f));}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:security": "node dist/database/production-seed.js",
    "verify:crm": "node scripts/verify-deploy.js crm",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
